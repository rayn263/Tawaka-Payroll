@namespace Tawaka.Ui.Shared.Components.Pages
@page "/employees/{EmployeeId:guid}"
@inject PayrollDbContext Db
@inject EmployeeContractService Contracts
@inject EmployeeService Employees
@inject UserSession Session

@if (_employee is null)
{
    <div class="card"><EmptyState Title="Employee not found" /></div>
}
else
{
    <div class="page-header">
        <div>
            <h1>@_employee.FullName</h1>
            <div class="subtitle">
                @_employee.EmployeeNumber
                @if (_currentContract is not null)
                {
                    <text> · @JobTitleName · @DepartmentName · @EmploymentTypeName</text>
                }
            </div>
        </div>
        <StatusBadge Employee="_employee.Status" />
    </div>

    <div class="tabs">
        @foreach (var tab in Tabs)
        {
            <button class="tab @(tab == _tab ? "active" : null)" @onclick="() => _tab = tab">@tab</button>
        }
    </div>

    <ValidationSummaryPanel Result="_validation" />

    <div class="card">
        @switch (_tab)
        {
            case "Personal":
                <dl class="detail">
                    <dt>Full name</dt><dd>@_employee.FullName</dd>
                    <dt>National ID</dt><dd>@Show(_employee.NationalId)</dd>
                    <dt>Date of birth</dt><dd>@Show(_employee.DateOfBirth)</dd>
                    <dt>Gender</dt><dd>@_employee.Gender</dd>
                    <dt>Nationality</dt><dd>@Show(_employee.Nationality)</dd>
                    <dt>Phone</dt><dd>@Show(_employee.Phone)</dd>
                    <dt>Email</dt><dd>@Show(_employee.Email)</dd>
                    <dt>Address</dt><dd>@Show(_employee.AddressLine1) @_employee.City</dd>
                </dl>

                @if (Session.HasPermission(Permissions.EmployeesEdit))
                {
                    @if (_editing is null)
                    {
                        <div class="form-actions">
                            <button class="btn btn-secondary" @onclick="StartEditAsync">
                                Edit details
                            </button>
                        </div>
                    }
                    else
                    {
                        <h3>Edit details</h3>
                        <div class="form-grid">
                            <div><label>Employee number *</label><input @bind="_editing.EmployeeNumber" /></div>
                            <div><label>First name *</label><input @bind="_editing.FirstName" /></div>
                            <div><label>Middle name</label><input @bind="_editing.MiddleName" /></div>
                            <div><label>Last name *</label><input @bind="_editing.LastName" /></div>
                            <div><label>National ID</label><input @bind="_editing.NationalId" /></div>
                            <div><label>Date of birth</label><input type="date" @bind="_editDateOfBirth" /></div>
                            <div>
                                <label>Gender</label>
                                <select @bind="_editing.Gender">
                                    @foreach (var gender in Enum.GetValues<Gender>())
                                    {
                                        <option value="@gender">@gender</option>
                                    }
                                </select>
                            </div>
                            <div><label>Nationality</label><input @bind="_editing.Nationality" /></div>
                            <div><label>Phone</label><input @bind="_editing.Phone" /></div>
                            <div><label>Email</label><input @bind="_editing.Email" /></div>
                            <div><label>Address</label><input @bind="_editing.AddressLine1" /></div>
                            <div><label>City</label><input @bind="_editing.City" /></div>
                        </div>
                        <div class="form-actions">
                            <button class="btn btn-primary" @onclick="SaveDetailsAsync" disabled="@_busy">
                                Save details
                            </button>
                            <button class="btn btn-quiet" @onclick="CancelEdit">Cancel</button>
                        </div>
                    }
                }

                break;

            case "Employment":
                <dl class="detail">
                    <dt>Engaged</dt><dd>@_employee.HireDate.ToString("dd MMM yyyy")</dd>
                    <dt>Status</dt><dd><StatusBadge Employee="_employee.Status" /></dd>
                    <dt>Employment type</dt><dd>@EmploymentTypeName</dd>
                    <dt>Job title</dt><dd>@JobTitleName</dd>
                    <dt>Department</dt><dd>@DepartmentName</dd>
                    <dt>Location</dt><dd>@LocationName</dd>
                    @if (_employee.TerminationDate is not null)
                    {
                        <dt>Terminated</dt><dd>@_employee.TerminationDate.Value.ToString("dd MMM yyyy")</dd>
                        <dt>Reason</dt><dd>@Show(_employee.TerminationReason)</dd>
                    }
                </dl>

                <h3>Status history</h3>
                @if (_statusHistory.Count == 0)
                {
                    <EmptyState Title="No status changes recorded" />
                }
                else
                {
                    <table class="data">
                        <thead><tr><th>Date</th><th>From</th><th>To</th><th>Reason</th><th>Changed by</th></tr></thead>
                        <tbody>
                        @foreach (var entry in _statusHistory)
                        {
                            <tr>
                                <td>@entry.EffectiveDate.ToString("dd MMM yyyy")</td>
                                <td>@entry.FromStatus</td>
                                <td>@entry.ToStatus</td>
                                <td>@Show(entry.Reason)</td>
                                <td>@entry.ChangedBy</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                }

                @if (Session.HasPermission(Permissions.EmployeesDeactivate) &&
                     _employee.Status != EmployeeStatus.Terminated)
                {
                    <h3>End employment</h3>
                    <p class="muted">
                        An employee is never deleted. Ending employment closes the current contract
                        and records the change; every payroll they were on stays exactly as it was.
                    </p>
                    <div class="form-grid">
                        <div>
                            <label>New status *</label>
                            <select @bind="_newStatus">
                                @foreach (var status in new[]
                                          {
                                              EmployeeStatus.Terminated, EmployeeStatus.Suspended,
                                              EmployeeStatus.Inactive, EmployeeStatus.Active
                                          })
                                {
                                    <option value="@status">@status</option>
                                }
                            </select>
                        </div>
                        <div><label>Effective date *</label><input type="date" @bind="_statusDate" /></div>
                        <div><label>Reason *</label><input @bind="_statusReason" /></div>
                    </div>
                    <div class="form-actions">
                        <button class="btn btn-secondary" @onclick="ChangeStatusAsync" disabled="@_busy">
                            Record status change
                        </button>
                    </div>
                }

                break;

            case "Contract":
                @if (!Session.HasPermission(Permissions.EmployeesViewSalary))
                {
                    <EmptyState Title="Salary information is restricted"
                                Description="You do not have permission to view salary and rates." />
                }
                else if (_contractHistory.Count == 0)
                {
                    <EmptyState Title="No contract recorded"
                                Description="This employee cannot be paid until a contract is captured." />
                }
                else
                {
                    <p class="muted">
                        Contract versions are never overwritten. Payroll for a past period uses the
                        version that applied then.
                    </p>
                    <table class="data">
                        <thead>
                        <tr>
                            <th>Version</th><th>From</th><th>To</th><th>Type</th><th>Frequency</th>
                            <th>Basis</th><th class="num">Rate</th><th>Reason for change</th><th>Status</th>
                        </tr>
                        </thead>
                        <tbody>
                        @foreach (var contract in _contractHistory)
                        {
                            <tr class="@(contract.IsCurrent ? "highlight" : null)">
                                <td>v@(contract.VersionNumber)</td>
                                <td>@contract.StartDate.ToString("dd MMM yyyy")</td>
                                <td>@(contract.EndDate?.ToString("dd MMM yyyy") ?? "—")</td>
                                <td>@TypeName(contract.EmploymentTypeId)</td>
                                <td>@contract.PaymentFrequency</td>
                                <td>@contract.EarningsBasis</td>
                                <td class="num">
                                    <MoneyText Amount="contract.PrimaryRate" Currency="contract.PayrollCurrency" />
                                </td>
                                <td>@Show(contract.ChangeReason)</td>
                                <td><StatusBadge Contract="contract.Status" /></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                }

                @if (Session.HasPermission(Permissions.EmployeesEditSalary) && _currentContract is not null)
                {
                    <h3>Change contract terms</h3>
                    <p class="muted">
                        This creates a new version from the date you give. The current version is
                        closed off, not overwritten, and payroll for a period before that date still
                        uses it.
                    </p>
                    <div class="form-grid">
                        <div>
                            <label>Effective from *</label>
                            <input type="date" @bind="_supersedeFrom" />
                        </div>
                        <div>
                            <label>Reason *</label>
                            <input @bind="_supersedeReason" placeholder="Annual review" />
                        </div>
                        <div>
                            <label>Payroll currency *</label>
                            <select @bind="_newTerms.PayrollCurrency">
                                @foreach (var currency in _currencies)
                                {
                                    <option value="@currency.Code">@currency.DisplayCode</option>
                                }
                            </select>
                        </div>
                        <div>
                            <label>Payment frequency *</label>
                            <select @bind="_newTerms.PaymentFrequency">
                                @foreach (var frequency in Enum.GetValues<PaymentFrequency>())
                                {
                                    <option value="@frequency">@frequency</option>
                                }
                            </select>
                        </div>
                        <div>
                            <label>Earnings basis *</label>
                            <select @bind="_newTerms.EarningsBasis">
                                @foreach (var basis in Enum.GetValues<EarningsBasis>())
                                {
                                    <option value="@basis">@basis</option>
                                }
                            </select>
                        </div>
                        <div><label>Monthly rate</label><input type="number" step="0.01" @bind="_newTerms.MonthlyRate" /></div>
                        <div><label>Daily rate</label><input type="number" step="0.01" @bind="_newTerms.DailyRate" /></div>
                        <div><label>Hourly rate</label><input type="number" step="0.01" @bind="_newTerms.HourlyRate" /></div>
                        <div><label>Contract end date</label><input type="date" @bind="_newTermsEnd" /></div>
                    </div>
                    <div class="form-actions">
                        <button class="btn btn-primary" @onclick="SupersedeAsync" disabled="@_busy">
                            Create new version
                        </button>
                    </div>
                }

                break;

            case "Earnings":
                @if (_earnings.Count == 0)
                {
                    <EmptyState Title="No recurring earnings"
                                Description="Standing allowances appear here once captured." />
                }
                else
                {
                    <table class="data">
                        <thead>
                        <tr><th>Earning</th><th class="num">Amount</th><th>From</th><th>To</th>
                            <th>Taxable</th><th>NSSA</th><th>Treatment</th></tr>
                        </thead>
                        <tbody>
                        @foreach (var earning in _earnings)
                        {
                            <tr>
                                <td>@earning.EarningType?.Name</td>
                                <td class="num"><MoneyText Amount="earning.Amount" Currency="earning.CurrencyCode" /></td>
                                <td>@earning.EffectiveFrom.ToString("dd MMM yyyy")</td>
                                <td>@(earning.EffectiveTo?.ToString("dd MMM yyyy") ?? "—")</td>
                                <td>@YesNo(earning.EarningType?.IsTaxable)</td>
                                <td>@YesNo(earning.EarningType?.IsNssaApplicable)</td>
                                <td>
                                    <StatusBadge Verification="earning.EarningType?.TreatmentVerificationStatus" />
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                }

                @if (Session.HasPermission(Permissions.EmployeesEditSalary))
                {
                    <h3>Add a recurring earning</h3>
                    <div class="form-grid">
                        <div>
                            <label>Earning *</label>
                            <select @bind="_earningTypeId">
                                <option value="">Select…</option>
                                @foreach (var type in _earningTypes)
                                {
                                    <option value="@type.Id">@type.Name</option>
                                }
                            </select>
                        </div>
                        <div><label>Amount *</label><input type="number" step="0.01" @bind="_earningAmount" /></div>
                        <div><label>From *</label><input type="date" @bind="_earningFrom" /></div>
                        <div><label>To</label><input type="date" @bind="_earningTo" /></div>
                    </div>
                    <div class="form-actions">
                        <button class="btn btn-primary" @onclick="AddEarningAsync" disabled="@_busy">
                            Add earning
                        </button>
                    </div>
                    <p class="muted small">
                        The amount is in the employee's payroll currency,
                        @(CurrencyLabel(_currentContract?.PayrollCurrency)). An earning whose tax or
                        NSSA treatment is unverified is priced in development mode only.
                    </p>
                }

                break;

            case "Deductions":
                @if (_deductions.Count == 0)
                {
                    <EmptyState Title="No recurring deductions"
                                Description="Medical aid, pension and union deductions appear here." />
                }
                else
                {
                    <table class="data">
                        <thead>
                        <tr><th>Deduction</th><th class="num">Amount</th><th>From</th><th>To</th>
                            <th>Reduces taxable income</th></tr>
                        </thead>
                        <tbody>
                        @foreach (var deduction in _deductions)
                        {
                            <tr>
                                <td>@deduction.DeductionType?.Name</td>
                                <td class="num"><MoneyText Amount="deduction.Amount" Currency="deduction.CurrencyCode" /></td>
                                <td>@deduction.EffectiveFrom.ToString("dd MMM yyyy")</td>
                                <td>@(deduction.EffectiveTo?.ToString("dd MMM yyyy") ?? "—")</td>
                                <td>@YesNo(deduction.DeductionType?.ReducesTaxableIncome)</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                }

                @if (Session.HasPermission(Permissions.EmployeesEditSalary))
                {
                    <h3>Add a recurring deduction</h3>
                    <div class="form-grid">
                        <div>
                            <label>Deduction *</label>
                            <select @bind="_deductionTypeId">
                                <option value="">Select…</option>
                                @foreach (var type in _deductionTypes)
                                {
                                    <option value="@type.Id">@type.Name</option>
                                }
                            </select>
                        </div>
                        <div><label>Amount *</label><input type="number" step="0.01" @bind="_deductionAmount" /></div>
                        <div><label>From *</label><input type="date" @bind="_deductionFrom" /></div>
                        <div><label>To</label><input type="date" @bind="_deductionTo" /></div>
                    </div>
                    <div class="form-actions">
                        <button class="btn btn-primary" @onclick="AddDeductionAsync" disabled="@_busy">
                            Add deduction
                        </button>
                    </div>
                }

                break;

            case "Statutory":
                <dl class="detail">
                    <dt>Tax number (ZIMRA)</dt><dd>@Show(_statutory?.TaxNumber)</dd>
                    <dt>PAYE exempt</dt><dd>@YesNo(_statutory?.IsPayeExempt)</dd>
                    <dt>NSSA number</dt><dd>@Show(_statutory?.NssaNumber)</dd>
                    <dt>NSSA coverage</dt><dd>@NssaCoverage</dd>
                    <dt>Elderly credit</dt><dd>@YesNo(_statutory?.IsElderlyCreditEligible)</dd>
                    <dt>Disabled credit</dt><dd>@YesNo(_statutory?.IsDisabledCreditEligible)</dd>
                    <dt>Blind credit</dt><dd>@YesNo(_statutory?.IsBlindCreditEligible)</dd>
                    <dt>NEC member</dt><dd>@YesNo(_statutory?.IsNecMember)</dd>
                </dl>
                @if (_statutory is null || string.IsNullOrWhiteSpace(_statutory.TaxNumber))
                {
                    <div class="alert alert-warning">
                        No tax number is recorded. This employee cannot be included in a statutory
                        return until one is captured.
                    </div>
                }

                @if (Session.HasPermission(Permissions.EmployeesEdit))
                {
                    <h3>Statutory identifiers</h3>
                    <div class="form-grid">
                        <div>
                            <label>Tax number (ZIMRA)</label>
                            <input @bind="_taxNumber" placeholder="BP1234567" />
                        </div>
                        <div>
                            <label>NSSA number</label>
                            <input @bind="_nssaNumber" />
                        </div>
                        <div>
                            <label>NEC membership number</label>
                            <input @bind="_necNumber" />
                        </div>
                        <div class="checkbox-list">
                            <label class="checkbox">
                                <input type="checkbox" @bind="_payeExempt" />
                                <span>PAYE exempt</span>
                            </label>
                            <label class="checkbox">
                                <input type="checkbox" @bind="_elderlyCredit" />
                                <span>Elderly credit</span>
                            </label>
                            <label class="checkbox">
                                <input type="checkbox" @bind="_disabledCredit" />
                                <span>Disabled credit</span>
                            </label>
                            <label class="checkbox">
                                <input type="checkbox" @bind="_blindCredit" />
                                <span>Blind credit</span>
                            </label>
                            <label class="checkbox">
                                <input type="checkbox" @bind="_necMember" />
                                <span>NEC member</span>
                            </label>
                        </div>
                    </div>
                    <div class="form-actions">
                        <button class="btn btn-primary" @onclick="SaveStatutoryAsync" disabled="@_busy">
                            Save statutory details
                        </button>
                    </div>
                }

                break;

            case "Payment":
                @if (_accounts.Count == 0)
                {
                    <EmptyState Title="No payment accounts"
                                Description="Add a bank account, mobile money number or cash arrangement." />
                }
                else
                {
                    <table class="data">
                        <thead>
                        <tr><th>Method</th><th>Currency</th><th>Account name</th><th>Details</th>
                            <th>Allocation</th><th>Primary</th></tr>
                        </thead>
                        <tbody>
                        @foreach (var account in _accounts)
                        {
                            <tr>
                                <td>@account.PaymentMethod</td>
                                <td>@(account.CurrencyCode == "ZWG" ? "ZiG" : account.CurrencyCode)</td>
                                <td>@Show(account.AccountName)</td>
                                <td>@account.Describe()</td>
                                <td>@account.AllocationType</td>
                                <td>@YesNo(account.IsPrimary)</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                    <p class="muted">
                        An account's currency is recorded per account: it does not have to match the
                        currency the employee's payroll is denominated in.
                    </p>
                }

                @if (Session.HasPermission(Permissions.EmployeesEdit))
                {
                    <h3>Add a payment account</h3>
                    <div class="form-grid">
                        <div>
                            <label>Method *</label>
                            <select @bind="_accountMethod">
                                @foreach (var method in Enum.GetValues<PaymentMethod>())
                                {
                                    <option value="@method">@method</option>
                                }
                            </select>
                        </div>
                        <div>
                            <label>Currency *</label>
                            <select @bind="_accountCurrency">
                                @foreach (var currency in _currencies)
                                {
                                    <option value="@currency.Code">@currency.DisplayCode</option>
                                }
                            </select>
                        </div>
                        <div><label>Account name</label><input @bind="_accountName" /></div>
                        <div><label>Bank</label><input @bind="_accountBank" /></div>
                        <div><label>Branch</label><input @bind="_accountBranch" /></div>
                        <div><label>Account number</label><input @bind="_accountNumber" /></div>
                        <div><label>Mobile money provider</label><input @bind="_accountProvider" /></div>
                        <div><label>Mobile money number</label><input @bind="_accountMobile" /></div>
                    </div>
                    <div class="form-actions">
                        <button class="btn btn-primary" @onclick="AddAccountAsync" disabled="@_busy">
                            Add account
                        </button>
                    </div>
                }

                break;

            case "Projects":
                @if (_assignments.Count == 0)
                {
                    <EmptyState Title="Not assigned to any project" />
                }
                else
                {
                    <table class="data">
                        <thead><tr><th>Project</th><th>From</th><th>To</th><th class="num">Allocation</th></tr></thead>
                        <tbody>
                        @foreach (var assignment in _assignments)
                        {
                            <tr>
                                <td>@assignment.Project?.Name</td>
                                <td>@assignment.StartDate.ToString("dd MMM yyyy")</td>
                                <td>@(assignment.EndDate?.ToString("dd MMM yyyy") ?? "—")</td>
                                <td class="num">@assignment.AllocationPercent.ToString("N0")%</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                }
                break;

            case "Leave":
                @if (_leaveBalances.Count == 0 && _leaveRequests.Count == 0)
                {
                    <EmptyState Title="No leave recorded"
                                Description="Leave requests and balances appear here once leave is captured in Time & Leave." />
                }
                else
                {
                    <h3>Balances</h3>
                    <table class="data">
                        <thead>
                        <tr><th>Leave type</th><th class="num">Entitlement</th>
                            <th class="num">Taken</th><th class="num">Balance</th></tr>
                        </thead>
                        <tbody>
                        @foreach (var balance in _leaveBalances)
                        {
                            <tr>
                                <td class="strong">@balance.LeaveType?.Name</td>
                                <td class="num">@Days(balance.EntitlementDays)</td>
                                <td class="num">@balance.DaysTaken.ToString("N2")</td>
                                <td class="num strong">@Days(balance.BalanceDays)</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                    <p class="muted small">
                        A balance shown as "—" is undetermined, not zero: the entitlement for that
                        leave type has not been established from an authoritative source.
                    </p>

                    <h3>Requests</h3>
                    <table class="data">
                        <thead>
                        <tr><th>Type</th><th>From</th><th>To</th><th class="num">Days</th>
                            <th>Paid</th><th>Status</th></tr>
                        </thead>
                        <tbody>
                        @foreach (var request in _leaveRequests)
                        {
                            <tr>
                                <td>@request.LeaveType?.Name</td>
                                <td>@request.StartDate.ToString("dd MMM yyyy")</td>
                                <td>@request.EndDate.ToString("dd MMM yyyy")</td>
                                <td class="num">@request.Days.ToString("N2")</td>
                                <td>@(request.IsPaid ? "Paid" : "Unpaid")</td>
                                <td>@request.ApprovalStatus</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                }
                break;

            case "Loans":
                @if (_loans.Count == 0)
                {
                    <EmptyState Title="No loans or advances"
                                Description="Loans appear here once raised in Loans & Advances." />
                }
                else
                {
                    <table class="data">
                        <thead>
                        <tr><th>Number</th><th>Kind</th><th>Currency</th><th class="num">Principal</th>
                            <th class="num">Repaid</th><th class="num">Outstanding</th><th>Status</th></tr>
                        </thead>
                        <tbody>
                        @foreach (var loan in _loans)
                        {
                            <tr>
                                <td class="mono">@loan.LoanNumber</td>
                                <td>@loan.Kind</td>
                                <td>@(loan.CurrencyCode == "ZWG" ? "ZiG" : loan.CurrencyCode)</td>
                                <td class="num">@loan.PrincipalAmount.ToString("N2")</td>
                                <td class="num">@loan.TotalRepaid.Amount.ToString("N2")</td>
                                <td class="num strong">@loan.Outstanding.Amount.ToString("N2")</td>
                                <td>@loan.Status</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                    <p class="muted small">
                        The outstanding balance is the sum of the loan's ledger, not a stored
                        figure. The full statement is in Loans &amp; Advances.
                    </p>
                }
                break;

            case "Payroll history":
                @if (_payrollHistory.Count == 0)
                {
                    <EmptyState Title="No payroll processed for this employee yet"
                                Description="Nothing is shown here because no payroll run has included them — not because it is hidden." />
                }
                else
                {
                    <div class="scroll-x">
                        <table class="data">
                            <thead>
                            <tr><th>Period</th><th>Currency</th><th class="num">Gross</th>
                                <th class="num">PAYE</th><th class="num">NSSA</th>
                                <th class="num">Net pay</th><th>Status</th><th></th></tr>
                            </thead>
                            <tbody>
                            @foreach (var row in _payrollHistory)
                            {
                                <tr>
                                    <td class="strong">@row.PeriodName</td>
                                    <td>@(row.Result.CurrencyCode == "ZWG" ? "ZiG" : row.Result.CurrencyCode)</td>
                                    <td class="num">@Figure(row.Result.GrossEarningsAmount)</td>
                                    <td class="num">@Figure(row.Result.PayeAfterCreditsAmount)</td>
                                    <td class="num">@Figure(row.Result.NssaEmployeeAmount)</td>
                                    <td class="num strong">@Figure(row.Result.NetPayAmount)</td>
                                    <td>@row.RunStatus</td>
                                    <td>
                                        <a class="btn btn-quiet"
                                           href="payroll/payslip/@row.Result.Id">Payslip</a>
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                    <p class="muted small">
                        Every figure here is the persisted payroll result. An absent amount shows
                        as "—": it could not be calculated, which is not the same as zero.
                    </p>
                }
                break;

            case "Documents":
                @if (_documents.Count == 0)
                {
                    <EmptyState Title="No documents attached"
                                Description="Contracts, identity documents and certificates can be attached here." />
                }
                else
                {
                    <table class="data">
                        <thead><tr><th>Type</th><th>Title</th><th>Expires</th></tr></thead>
                        <tbody>
                        @foreach (var document in _documents)
                        {
                            <tr>
                                <td>@document.DocumentType</td>
                                <td>@document.Title</td>
                                <td>@(document.ExpiryDate?.ToString("dd MMM yyyy") ?? "—")</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                }
                break;
        }
    </div>
}

@code {
    [Parameter] public Guid EmployeeId { get; set; }

    private record PayrollHistoryRow(string PeriodName, string RunStatus, PayrollRunEmployee Result);

    /// <summary>An absent figure is not zero, on this screen as everywhere else.</summary>
    private static string Figure(decimal? amount) => amount?.ToString("N2") ?? "—";

    private static string Days(decimal? days) => days?.ToString("N2") ?? "—";

    private static readonly string[] Tabs =
    {
        "Personal", "Employment", "Contract", "Earnings", "Deductions", "Statutory",
        "Payment", "Projects", "Leave", "Loans", "Payroll history", "Documents"
    };

    private string _tab = "Personal";

    private Employee? _employee;
    private EmployeeStatutoryProfile? _statutory;
    private EmployeeContract? _currentContract;
    private List<EmployeeContract> _contractHistory = new();
    private List<EmployeeStatusHistory> _statusHistory = new();
    private List<EmployeeRecurringEarning> _earnings = new();
    private List<EmployeeRecurringDeduction> _deductions = new();
    private List<EmployeePaymentAccount> _accounts = new();
    private List<EmployeeProjectAssignment> _assignments = new();
    private List<EmployeeDocument> _documents = new();
    private List<Domain.Leave.LeaveEntitlement> _leaveBalances = new();
    private List<Domain.Leave.LeaveRequest> _leaveRequests = new();
    private List<Domain.Loans.EmployeeLoan> _loans = new();
    private List<PayrollHistoryRow> _payrollHistory = new();
    private Dictionary<Guid, string> _types = new();
    private Dictionary<Guid, string> _jobTitles = new();
    private Dictionary<Guid, string> _departments = new();
    private Dictionary<Guid, string> _locations = new();

    // ---- Editing state ---------------------------------------------------------------------
    private List<Domain.Currencies.Currency> _currencies = new();
    private List<EarningType> _earningTypes = new();
    private List<DeductionType> _deductionTypes = new();
    private ValidationResult? _validation;
    private bool _busy;

    private Employee? _editing;
    private DateTime? _editDateOfBirth;

    private EmployeeStatus _newStatus = EmployeeStatus.Terminated;
    private DateTime _statusDate = DateTime.Today;
    private string _statusReason = string.Empty;

    private readonly EmployeeContract _newTerms = new();
    private DateTime _supersedeFrom = DateTime.Today;
    private DateTime? _newTermsEnd;
    private string _supersedeReason = string.Empty;

    private string _earningTypeId = string.Empty;
    private decimal _earningAmount;
    private DateTime _earningFrom = DateTime.Today;
    private DateTime? _earningTo;

    private string _deductionTypeId = string.Empty;
    private decimal _deductionAmount;
    private DateTime _deductionFrom = DateTime.Today;
    private DateTime? _deductionTo;

    private string _taxNumber = string.Empty;
    private string _nssaNumber = string.Empty;
    private string _necNumber = string.Empty;
    private bool _payeExempt;
    private bool _elderlyCredit;
    private bool _disabledCredit;
    private bool _blindCredit;
    private bool _necMember;

    private PaymentMethod _accountMethod = PaymentMethod.BankTransfer;
    private string _accountCurrency = string.Empty;
    private string _accountName = string.Empty;
    private string _accountBank = string.Empty;
    private string _accountBranch = string.Empty;
    private string _accountNumber = string.Empty;
    private string _accountProvider = string.Empty;
    private string _accountMobile = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        _employee = await Db.Employees.AsNoTracking()
            .FirstOrDefaultAsync(e => e.Id == EmployeeId);
        if (_employee is null)
        {
            return;
        }

        _statutory = await Db.EmployeeStatutoryProfiles.AsNoTracking()
            .FirstOrDefaultAsync(p => p.EmployeeId == EmployeeId);

        // The forms start from what is recorded, so editing is a correction rather than a retype.
        _taxNumber = _statutory?.TaxNumber ?? string.Empty;
        _nssaNumber = _statutory?.NssaNumber ?? string.Empty;
        _necNumber = _statutory?.NecMembershipNumber ?? string.Empty;
        _payeExempt = _statutory?.IsPayeExempt ?? false;
        _elderlyCredit = _statutory?.IsElderlyCreditEligible ?? false;
        _disabledCredit = _statutory?.IsDisabledCreditEligible ?? false;
        _blindCredit = _statutory?.IsBlindCreditEligible ?? false;
        _necMember = _statutory?.IsNecMember ?? false;

        _currencies = await Db.Currencies.AsNoTracking()
            .Where(c => c.IsActive).OrderBy(c => c.SortOrder).ToListAsync();
        _earningTypes = await Db.EarningTypes.AsNoTracking()
            .Where(t => t.CompanyId == _employee.CompanyId && t.IsActive && t.Code != "BASIC")
            .OrderBy(t => t.Name).ToListAsync();
        _deductionTypes = await Db.DeductionTypes.AsNoTracking()
            .Where(t => t.CompanyId == _employee.CompanyId && t.IsActive)
            .OrderBy(t => t.Name).ToListAsync();
        _contractHistory = await Contracts.GetHistoryAsync(EmployeeId);
        _currentContract = _contractHistory.FirstOrDefault(c => c.IsCurrent);

        // A new contract version starts from the terms in force, and an account from the currency
        // the employee is actually paid in: both are corrections far more often than rewrites.
        if (_currentContract is not null && string.IsNullOrEmpty(_newTerms.PayrollCurrency))
        {
            _newTerms.PayrollCurrency = _currentContract.PayrollCurrency;
            _newTerms.PaymentFrequency = _currentContract.PaymentFrequency;
            _newTerms.EarningsBasis = _currentContract.EarningsBasis;
            _newTerms.MonthlyRate = _currentContract.MonthlyRate;
            _newTerms.DailyRate = _currentContract.DailyRate;
            _newTerms.HourlyRate = _currentContract.HourlyRate;
        }

        if (string.IsNullOrEmpty(_accountCurrency))
        {
            _accountCurrency = _currentContract?.PayrollCurrency
                               ?? _currencies.FirstOrDefault()?.Code
                               ?? string.Empty;
        }
        _statusHistory = await Db.EmployeeStatusHistory.AsNoTracking()
            .Where(h => h.EmployeeId == EmployeeId)
            .OrderByDescending(h => h.EffectiveDate).ToListAsync();
        _earnings = await Db.EmployeeRecurringEarnings.AsNoTracking()
            .Include(e => e.EarningType)
            .Where(e => e.EmployeeId == EmployeeId).ToListAsync();
        _deductions = await Db.EmployeeRecurringDeductions.AsNoTracking()
            .Include(d => d.DeductionType)
            .Where(d => d.EmployeeId == EmployeeId).ToListAsync();
        _accounts = await Db.EmployeePaymentAccounts.AsNoTracking()
            .Where(a => a.EmployeeId == EmployeeId).ToListAsync();
        _assignments = await Db.EmployeeProjectAssignments.AsNoTracking()
            .Include(a => a.Project)
            .Where(a => a.EmployeeId == EmployeeId).ToListAsync();
        _documents = await Db.EmployeeDocuments.AsNoTracking()
            .Where(d => d.EmployeeId == EmployeeId).ToListAsync();

        // Leave, loans and payroll history belong on the employee, not in three other modules the
        // user has to visit to answer one question about one person.
        var today = DateOnly.FromDateTime(DateTime.Today);
        _leaveBalances = await Db.LeaveEntitlements.AsNoTracking()
            .Include(e => e.Transactions)
            .Include(e => e.LeaveType)
            .Where(e => e.EmployeeId == EmployeeId &&
                        e.LeaveYearStart <= today && e.LeaveYearEnd >= today)
            .ToListAsync();

        _leaveRequests = await Db.LeaveRequests.AsNoTracking()
            .Include(r => r.LeaveType)
            .Where(r => r.EmployeeId == EmployeeId)
            .OrderByDescending(r => r.StartDate)
            .Take(30)
            .ToListAsync();

        _loans = await Db.EmployeeLoans.AsNoTracking()
            .Include(l => l.Transactions)
            .Where(l => l.EmployeeId == EmployeeId)
            .OrderByDescending(l => l.CreatedAt)
            .ToListAsync();

        var results = await Db.PayrollRunEmployees.AsNoTracking()
            .Include(e => e.PayrollRun).ThenInclude(r => r!.PayrollPeriod)
            .Where(e => e.EmployeeId == EmployeeId && !e.IsExcluded)
            .OrderByDescending(e => e.PayrollRun!.PayrollPeriod!.PayDate)
            .Take(24)
            .ToListAsync();

        _payrollHistory = results.Select(r => new PayrollHistoryRow(
            r.PayrollRun?.PayrollPeriod?.Name ?? "Payroll run",
            r.PayrollRun?.Status.ToString() ?? "—",
            r)).ToList();

        _types = await Db.EmploymentTypes.AsNoTracking().ToDictionaryAsync(t => t.Id, t => t.Name);
        _jobTitles = await Db.JobTitles.AsNoTracking().ToDictionaryAsync(j => j.Id, j => j.Name);
        _departments = await Db.Departments.AsNoTracking().ToDictionaryAsync(d => d.Id, d => d.Name);
        _locations = await Db.Locations.AsNoTracking().ToDictionaryAsync(l => l.Id, l => l.Name);
    }

    private string EmploymentTypeName =>
        _currentContract is null ? "—" : TypeName(_currentContract.EmploymentTypeId);

    private string TypeName(Guid id) => _types.TryGetValue(id, out var name) ? name : "—";

    private string JobTitleName => Lookup(_jobTitles, _currentContract?.JobTitleId);

    private string DepartmentName => Lookup(_departments, _currentContract?.DepartmentId);

    private string LocationName => Lookup(_locations, _currentContract?.LocationId);

    private string NssaCoverage
    {
        get
        {
            if (_statutory?.NssaEligibilityOverride is { } over)
            {
                return over ? "Covered (overridden)" : "Not covered (overridden)";
            }

            if (_currentContract is null)
            {
                return "Determined by the eligibility rule for the employment type";
            }

            var code = _types.TryGetValue(_currentContract.EmploymentTypeId, out var name) ? name : "—";
            return $"Per the NSSA eligibility rule for {code}";
        }
    }

    private static string Lookup(IReadOnlyDictionary<Guid, string> source, Guid? id) =>
        id.HasValue && source.TryGetValue(id.Value, out var value) ? value : "—";

    private static string Show(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;

    private static string Show(DateOnly? value) => value?.ToString("dd MMM yyyy") ?? "—";

    private static string YesNo(bool? value) => value is null ? "—" : value.Value ? "Yes" : "No";

    private static string CurrencyLabel(string? code) =>
        code is null ? "the contract currency" : code == "ZWG" ? "ZiG" : code;

    /// <summary>
    /// The edit form works on the tracked entity, because that is what the service saves. Cancel
    /// throws the tracked changes away rather than writing them.
    /// </summary>
    private async Task StartEditAsync()
    {
        _validation = null;
        Db.ChangeTracker.Clear();
        _editing = await Db.Employees.FirstOrDefaultAsync(e => e.Id == EmployeeId);
        _editDateOfBirth = _editing?.DateOfBirth?.ToDateTime(TimeOnly.MinValue);
    }

    private void CancelEdit()
    {
        _editing = null;
        _validation = null;
        Db.ChangeTracker.Clear();
    }

    private async Task SaveDetailsAsync()
    {
        _busy = true;
        try
        {
            _editing!.DateOfBirth = _editDateOfBirth is { } dob
                ? DateOnly.FromDateTime(dob)
                : null;

            var result = await Employees.UpdateAsync(_editing);
            if (!result.IsValid)
            {
                _validation = result;
                return;
            }

            _editing = null;
            _validation = null;
            await ReloadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ChangeStatusAsync()
    {
        _busy = true;
        try
        {
            var result = await Employees.ChangeStatusAsync(
                EmployeeId, _newStatus, DateOnly.FromDateTime(_statusDate), _statusReason);

            if (!result.IsValid)
            {
                _validation = result;
                return;
            }

            _validation = null;
            _statusReason = string.Empty;
            await ReloadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SupersedeAsync()
    {
        _busy = true;
        try
        {
            _newTerms.CompanyId = _employee!.CompanyId;
            _newTerms.EmployeeId = EmployeeId;
            _newTerms.EmploymentTypeId = _currentContract!.EmploymentTypeId;
            _newTerms.JobTitleId = _currentContract.JobTitleId;
            _newTerms.DepartmentId = _currentContract.DepartmentId;
            _newTerms.LocationId = _currentContract.LocationId;
            _newTerms.ProjectId = _currentContract.ProjectId;
            _newTerms.StandardHoursPerDay = _currentContract.StandardHoursPerDay;
            _newTerms.StandardDaysPerWeek = _currentContract.StandardDaysPerWeek;
            _newTerms.EndDate = _newTermsEnd is { } end ? DateOnly.FromDateTime(end) : null;

            var result = await Contracts.SupersedeAsync(
                EmployeeId, _newTerms, DateOnly.FromDateTime(_supersedeFrom), _supersedeReason);

            if (!result.Succeeded)
            {
                _validation = result.Validation;
                return;
            }

            _validation = null;
            _supersedeReason = string.Empty;
            await ReloadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task AddEarningAsync()
    {
        _busy = true;
        try
        {
            var validation = ValidationResult.Success();
            validation.AddIf(!Guid.TryParse(_earningTypeId, out var typeId), "Earning",
                "Choose the kind of earning.");
            validation.AddIf(_earningAmount <= 0m, "Amount", "An amount is required.");

            if (!validation.IsValid)
            {
                _validation = validation;
                return;
            }

            Db.EmployeeRecurringEarnings.Add(new EmployeeRecurringEarning
            {
                EmployeeId = EmployeeId,
                EarningTypeId = typeId,
                Amount = _earningAmount,
                CurrencyCode = _currentContract?.PayrollCurrency ?? _accountCurrency,
                EffectiveFrom = DateOnly.FromDateTime(_earningFrom),
                EffectiveTo = _earningTo is { } to ? DateOnly.FromDateTime(to) : null,
                IsActive = true
            });

            await Db.SaveChangesAsync();

            _validation = null;
            _earningTypeId = string.Empty;
            _earningAmount = 0m;
            await ReloadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task AddDeductionAsync()
    {
        _busy = true;
        try
        {
            var validation = ValidationResult.Success();
            validation.AddIf(!Guid.TryParse(_deductionTypeId, out var typeId), "Deduction",
                "Choose the kind of deduction.");
            validation.AddIf(_deductionAmount <= 0m, "Amount", "An amount is required.");

            if (!validation.IsValid)
            {
                _validation = validation;
                return;
            }

            Db.EmployeeRecurringDeductions.Add(new EmployeeRecurringDeduction
            {
                EmployeeId = EmployeeId,
                DeductionTypeId = typeId,
                Amount = _deductionAmount,
                CurrencyCode = _currentContract?.PayrollCurrency ?? _accountCurrency,
                EffectiveFrom = DateOnly.FromDateTime(_deductionFrom),
                EffectiveTo = _deductionTo is { } to ? DateOnly.FromDateTime(to) : null,
                IsActive = true
            });

            await Db.SaveChangesAsync();

            _validation = null;
            _deductionTypeId = string.Empty;
            _deductionAmount = 0m;
            await ReloadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SaveStatutoryAsync()
    {
        _busy = true;
        try
        {
            Db.ChangeTracker.Clear();

            var profile = await Db.EmployeeStatutoryProfiles
                .FirstOrDefaultAsync(p => p.EmployeeId == EmployeeId);

            if (profile is null)
            {
                profile = new EmployeeStatutoryProfile { EmployeeId = EmployeeId };
                Db.EmployeeStatutoryProfiles.Add(profile);
            }

            profile.TaxNumber = Trimmed(_taxNumber);
            profile.NssaNumber = Trimmed(_nssaNumber);
            profile.NecMembershipNumber = Trimmed(_necNumber);
            profile.IsPayeExempt = _payeExempt;
            profile.IsElderlyCreditEligible = _elderlyCredit;
            profile.IsDisabledCreditEligible = _disabledCredit;
            profile.IsBlindCreditEligible = _blindCredit;
            profile.IsNecMember = _necMember;

            await Db.SaveChangesAsync();

            _validation = null;
            await ReloadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task AddAccountAsync()
    {
        _busy = true;
        try
        {
            var account = new EmployeePaymentAccount
            {
                EmployeeId = EmployeeId,
                PaymentMethod = _accountMethod,
                CurrencyCode = _accountCurrency,
                AccountName = Trimmed(_accountName),
                BankName = Trimmed(_accountBank),
                BranchName = Trimmed(_accountBranch),
                AccountNumber = Trimmed(_accountNumber),
                MobileMoneyProvider = Trimmed(_accountProvider),
                MobileMoneyNumber = Trimmed(_accountMobile),
                AllocationType = AllocationType.FullBalance,
                IsPrimary = _accounts.Count == 0,
                IsActive = true
            };

            var validation = EmployeeValidation.ValidatePaymentAccount(account);
            if (!validation.IsValid)
            {
                _validation = validation;
                return;
            }

            Db.EmployeePaymentAccounts.Add(account);
            await Db.SaveChangesAsync();

            _validation = null;
            _accountName = _accountBank = _accountBranch = string.Empty;
            _accountNumber = _accountProvider = _accountMobile = string.Empty;
            await ReloadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private static string? Trimmed(string? value) =>
        string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private Task ReloadAsync()
    {
        Db.ChangeTracker.Clear();
        return OnParametersSetAsync();
    }
}
