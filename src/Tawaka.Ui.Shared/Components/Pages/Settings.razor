@namespace Tawaka.Ui.Shared.Components.Pages
@page "/settings"
@using Tawaka.Application.Accounting
@using Tawaka.Domain.Accounting
@inject PayrollDbContext Db
@inject UserSession Session
@inject JournalExportService Journals
@inject Tawaka.Infrastructure.Administration.BackupService Backups

<h1>Settings</h1>

<div class="tabs">
    @foreach (var tab in Tabs)
    {
        <button class="tab @(tab == _tab ? "active" : null)" @onclick="() => _tab = tab">@tab</button>
    }
</div>

<ValidationSummaryPanel Result="_validation" />
@if (_saved)
{
    <div class="alert alert-success">Saved.</div>
}

@if (_company is null)
{
    <div class="card"><EmptyState Title="No company record" /></div>
}
else if (_tab == "Company profile")
{
    <div class="card">
        <h2>Identity</h2>
        <div class="form-grid">
            <div><label>Legal name *</label><input @bind="_company.LegalName" /></div>
            <div><label>Trading name</label><input @bind="_company.TradingName" /></div>
            <div><label>Registration number</label><input @bind="_company.RegistrationNumber" /></div>
            <div><label>Phone</label><input @bind="_company.Phone" /></div>
            <div><label>Email</label><input @bind="_company.Email" /></div>
            <div><label>Address</label><input @bind="_company.AddressLine1" /></div>
            <div><label>City</label><input @bind="_company.City" /></div>
            <div><label>Logo file path</label><input @bind="_company.LogoPath" /></div>
        </div>
        <p class="muted">
            The trading name appears on payslips where set. Bank accounts are named separately —
            an account is often held in a style that matches neither name.
        </p>
    </div>

    <div class="card">
        <h2>Statutory identifiers</h2>
        <div class="form-grid">
            <div><label>ZIMRA tax / BP number</label><input @bind="_company.TaxNumber" /></div>
            <div><label>PAYE reference</label><input @bind="_company.PayeReference" /></div>
            <div><label>NSSA employer number</label><input @bind="_company.NssaEmployerNumber" /></div>
            <div><label>ZIMDEF number</label><input @bind="_company.ZimdefNumber" /></div>
            <div><label>SDF number</label><input @bind="_company.StandardsDevelopmentFundNumber" /></div>
            <div><label>NEC code</label><input @bind="_company.NecCode" /></div>
            <div><label>NEC membership number</label><input @bind="_company.NecMembershipNumber" /></div>
            <div><label>Industry classification</label><input @bind="_company.IndustryClassification" /></div>
            <div><label>APWCS industry code</label><input @bind="_company.ApwcsIndustryCode" /></div>
        </div>
        <p class="muted">
            The APWCS industry code and its assessed rate are issued by NSSA following the annual
            WC50 assessment. The system will not estimate a rate.
        </p>
        <div class="form-actions">
            <button class="btn btn-primary" @onclick="SaveCompanyAsync"
                    disabled="@(!Session.HasPermission(Permissions.CompanyEdit))">
                Save company profile
            </button>
        </div>
    </div>
}
else if (_tab == "Currencies")
{
    <div class="card">
        <h2>Payroll currencies</h2>
        <table class="data">
            <thead>
            <tr><th>Code</th><th>Name</th><th>Display as</th><th class="num">Decimals</th>
                <th>Enabled</th><th>Default payroll</th><th>Default reporting</th></tr>
            </thead>
            <tbody>
            @foreach (var currency in _currencies)
            {
                var reference = _referenceCurrencies.FirstOrDefault(c => c.Code == currency.CurrencyCode);
                <tr>
                    <td class="mono">@currency.CurrencyCode</td>
                    <td>@(reference?.Name ?? "—")</td>
                    <td>@(currency.DisplayCodeOverride ?? reference?.DisplayCode ?? currency.CurrencyCode)</td>
                    <td class="num">@(currency.DecimalPlacesOverride ?? reference?.DecimalPlaces ?? 2)</td>
                    <td><input type="checkbox" @bind="currency.IsEnabled" /></td>
                    <td><input type="radio" name="defaultPayroll"
                               checked="@currency.IsDefaultPayrollCurrency"
                               @onchange="() => SetDefaultPayroll(currency)" /></td>
                    <td><input type="radio" name="defaultReporting"
                               checked="@currency.IsDefaultReportingCurrency"
                               @onchange="() => SetDefaultReporting(currency)" /></td>
                </tr>
            }
            </tbody>
        </table>
        <p class="muted">
            The reporting currency controls presentation only. Totals in different currencies are
            never added together; a consolidated figure always states the rate and date used.
        </p>
        <div class="form-actions">
            <button class="btn btn-primary" @onclick="SaveCurrenciesAsync"
                    disabled="@(!Session.HasPermission(Permissions.CompanyEdit))">
                Save currencies
            </button>
        </div>
    </div>

    <div class="card">
        <h2>Exchange rates</h2>
        @if (_rates.Count == 0)
        {
            <EmptyState Title="No exchange rates captured"
                        Description="A rate is required only where an employee is paid in more than one currency, or for consolidated reporting. Rates are never hard-coded." />
        }
        else
        {
            <table class="data">
                <thead><tr><th>From</th><th>To</th><th class="num">Rate</th><th>Type</th>
                    <th>Rate date</th><th>Source</th></tr></thead>
                <tbody>
                @foreach (var rate in _rates)
                {
                    <tr>
                        <td>@rate.FromCurrency</td>
                        <td>@rate.ToCurrency</td>
                        <td class="num">@rate.Rate.ToString("N4")</td>
                        <td>@rate.RateType</td>
                        <td>@rate.RateDate.ToString("dd MMM yyyy")</td>
                        <td>@rate.Source</td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </div>
}
else if (_tab == "Bank accounts")
{
    <div class="card">
        <h2>Company bank accounts</h2>
        <p class="muted">
            A company normally holds separate accounts per currency, and may pay net wages from one
            account and statutory obligations from another.
        </p>
        @if (_bankAccounts.Count == 0)
        {
            <EmptyState Title="No bank accounts captured" />
        }
        else
        {
            <table class="data">
                <thead><tr><th>Account name</th><th>Bank</th><th>Number</th><th>Currency</th>
                    <th>Purpose</th><th>Default</th><th>Active</th></tr></thead>
                <tbody>
                @foreach (var account in _bankAccounts)
                {
                    <tr>
                        <td class="strong">@account.AccountName</td>
                        <td>@account.BankName</td>
                        <td class="mono">@account.AccountNumber</td>
                        <td>@(account.CurrencyCode == "ZWG" ? "ZiG" : account.CurrencyCode)</td>
                        <td>@account.Purpose</td>
                        <td>@(account.IsDefaultForPurpose ? "Yes" : "No")</td>
                        <td>@(account.IsActive ? "Yes" : "No")</td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </div>

    @if (Session.HasPermission(Permissions.CompanyEdit))
    {
        <div class="card">
            <h2>Add bank account</h2>
            <div class="form-grid">
                <div><label>Account name *</label><input @bind="_accountName" /></div>
                <div><label>Bank *</label><input @bind="_bankName" /></div>
                <div><label>Branch</label><input @bind="_branchName" /></div>
                <div><label>Account number *</label><input @bind="_accountNumber" /></div>
                <div>
                    <label>Currency *</label>
                    <select @bind="_accountCurrency">
                        @foreach (var currency in _referenceCurrencies)
                        {
                            <option value="@currency.Code">@currency.DisplayCode</option>
                        }
                    </select>
                </div>
                <div>
                    <label>Purpose</label>
                    <select @bind="_accountPurpose">
                        @foreach (var purpose in Enum.GetValues<PaymentPurpose>())
                        {
                            <option value="@purpose">@purpose</option>
                        }
                    </select>
                </div>
            </div>
            <div class="form-actions">
                <button class="btn btn-primary" @onclick="AddBankAccountAsync">Add account</button>
            </div>
        </div>
    }
}
else if (_tab == "Organisation")
{
    <OrganisationSettings />
}
else if (_tab == "Earnings & deductions")
{
    <div class="card">
        <h2>Earning types</h2>
        <p class="muted">
            Whether an allowance is taxable or NSSA-applicable is configuration, not code — and each
            treatment carries its own verification grade, exactly like a tax table.
        </p>
        <table class="data">
            <thead><tr><th>Code</th><th>Name</th><th>Category</th><th>Taxable</th><th>NSSA</th>
                <th>In gross</th><th>Treatment</th></tr></thead>
            <tbody>
            @foreach (var type in _earningTypes)
            {
                <tr>
                    <td class="mono">@type.Code</td>
                    <td>@type.Name</td>
                    <td>@type.Category</td>
                    <td>@(type.IsTaxable ? "Yes" : "No")</td>
                    <td>@(type.IsNssaApplicable ? "Yes" : "No")</td>
                    <td>@(type.IsIncludedInGross ? "Yes" : "No")</td>
                    <td><StatusBadge Verification="type.TreatmentVerificationStatus" /></td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    <div class="card">
        <h2>Deduction types</h2>
        <table class="data">
            <thead><tr><th>Code</th><th>Name</th><th>Category</th>
                <th>Reduces taxable income</th><th>Treatment</th></tr></thead>
            <tbody>
            @foreach (var type in _deductionTypes)
            {
                <tr>
                    <td class="mono">@type.Code</td>
                    <td>@type.Name</td>
                    <td>@type.Category</td>
                    <td>@(type.ReducesTaxableIncome ? "Yes" : "No")</td>
                    <td><StatusBadge Verification="type.TreatmentVerificationStatus" /></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

else if (_tab == "Accounting")
{
    <div class="card">
        <h2>General ledger mapping</h2>
        <p class="muted small">
            Each payroll amount needs an account, per currency. A USD wages account and a ZiG wages
            account are different accounts in every chart of accounts this system will meet, and
            mapping both to one is how a journal ends up mixing currencies.
        </p>

        <div class="scroll-x">
            <table class="data">
                <thead>
                <tr><th>Amount</th><th>Currency</th><th>Account code</th><th>Account name</th>
                    <th>Cost centre</th><th></th></tr>
                </thead>
                <tbody>
                @foreach (var currency in _currencies.Where(c => c.IsEnabled))
                {
                    @foreach (var type in Enum.GetValues<GlMappingType>())
                    {
                        var existing = _glMappings.FirstOrDefault(m =>
                            m.MappingType == type && m.CurrencyCode == currency.CurrencyCode);
                        var key = $"{currency.CurrencyCode}:{type}";

                        <tr>
                            <td class="strong">@Describe(type)</td>
                            <td>@(currency.CurrencyCode == "ZWG" ? "ZiG" : currency.CurrencyCode)</td>
                            <td>
                                <input value='@Edit(key, "code", existing?.AccountCode)'
                                       @onchange='e => SetEdit(key, "code", e.Value)' />
                            </td>
                            <td>
                                <input value='@Edit(key, "name", existing?.AccountName)'
                                       @onchange='e => SetEdit(key, "name", e.Value)' />
                            </td>
                            <td>
                                <input value='@Edit(key, "cc", existing?.CostCentre)'
                                       @onchange='e => SetEdit(key, "cc", e.Value)' />
                            </td>
                            <td>
                                @if (Session.HasPermission(Permissions.SettingsEdit))
                                {
                                    <button class="btn btn-quiet"
                                            @onclick="() => SaveMappingAsync(type, currency.CurrencyCode, key)">
                                        Save
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
        <p class="muted small">
            An amount with no mapped account is listed as unmapped on the journal rather than posted
            to a default. A suspense posting nobody asked for is how payroll errors reach the trial
            balance and stay there.
        </p>
    </div>
}
else if (_tab == "Backup & restore")
{
    <div class="card">
        <h2>Backup</h2>
        <div class="form-grid">
            <div><label>Backup folder *</label><input @bind="_backupFolder" /></div>
            <div><label>Note</label><input @bind="_backupNote" placeholder="Before October payroll" /></div>
        </div>
        <p class="muted small">
            A backup is a consistent copy taken through SQLite's own backup mechanism, not a file
            copy of a database that may be mid-write, plus a manifest naming the schema it was
            taken on.
        </p>
        <div class="form-actions">
            @if (Session.HasPermission(Permissions.SettingsEdit))
            {
                <button class="btn btn-primary" @onclick="BackupAsync">Take a backup</button>
            }
        </div>

        @if (_lastBackup is not null)
        {
            <div class="alert alert-success">
                <strong>Backup written.</strong>
                @_lastBackup.BackupPath — @_lastBackup.Manifest.DatabaseBytes.ToString("N0") bytes,
                schema @_lastBackup.Manifest.SchemaVersion.
            </div>
        }

        <div class="detail-grid">
            <div>
                <span class="detail-label">Live database</span>
                <span class="mono">@(_databasePath ?? "not file-backed")</span>
            </div>
        </div>
    </div>

    <div class="card">
        <h2>Restore</h2>
        <div class="alert alert-warning">
            <strong>Restoring replaces all current payroll data.</strong>
            The database in use is set aside with a timestamped name first, so a failed restore can
            be undone. Nothing is ever silently overwritten.
        </div>

        <div class="form-grid">
            <div><label>Backup folder *</label><input @bind="_restoreFolder" /></div>
        </div>
        <div class="form-actions">
            <button class="btn btn-secondary" @onclick="InspectAsync">Check this backup</button>
        </div>

        @if (_inspection is not null)
        {
            @if (_inspection.Manifest is { } manifest)
            {
                <div class="detail-grid">
                    <div><span class="detail-label">Taken</span>@manifest.TakenAt.ToString("dd MMM yyyy HH:mm")</div>
                    <div><span class="detail-label">By</span>@manifest.TakenBy</div>
                    <div><span class="detail-label">Company</span>@(manifest.CompanyName ?? "—")</div>
                    <div><span class="detail-label">Schema</span>@manifest.SchemaVersion</div>
                    <div><span class="detail-label">Size</span>@manifest.DatabaseBytes.ToString("N0") bytes</div>
                    <div><span class="detail-label">Note</span>@(manifest.Notes ?? "—")</div>
                </div>
            }

            @if (_inspection.Problems.Count > 0)
            {
                <div class="alert alert-error">
                    <ul>
                        @foreach (var problem in _inspection.Problems)
                        {
                            <li>@problem</li>
                        }
                    </ul>
                </div>
            }
            else if (_inspection.CanRestore && Session.HasPermission(Permissions.SettingsEdit))
            {
                <div class="form-grid">
                    <div>
                        <label>
                            <input type="checkbox" @bind="_restoreConfirmed" />
                            I understand this replaces all current payroll data
                        </label>
                    </div>
                </div>
                <div class="form-actions">
                    <button class="btn btn-primary" @onclick="RestoreAsync">Restore</button>
                </div>
            }
        }

        @if (_restoreMessage is not null)
        {
            <div class="alert alert-success">
                <strong>Restored.</strong> @_restoreMessage
                Close and reopen Tawaka Payroll so it reads the restored database.
            </div>
        }
    </div>
}

@code {
    private static readonly string[] Tabs =
    {
        "Company profile", "Currencies", "Bank accounts", "Organisation",
        "Earnings & deductions", "Accounting", "Backup & restore"
    };

    private string _tab = "Company profile";

    private List<GlAccountMapping> _glMappings = new();
    private readonly Dictionary<string, string> _glEdits = new();

    private string _backupFolder = string.Empty;
    private string _backupNote = string.Empty;
    private string _restoreFolder = string.Empty;
    private bool _restoreConfirmed;
    private string? _databasePath;
    private string? _restoreMessage;
    private Tawaka.Infrastructure.Administration.BackupResult? _lastBackup;
    private Tawaka.Infrastructure.Administration.RestoreInspection? _inspection;
    private ValidationResult? _validation;
    private bool _saved;

    private Company? _company;
    private List<CompanyCurrency> _currencies = new();
    private List<Domain.Currencies.Currency> _referenceCurrencies = new();
    private List<Domain.Currencies.ExchangeRate> _rates = new();
    private List<CompanyBankAccount> _bankAccounts = new();
    private List<EarningType> _earningTypes = new();
    private List<DeductionType> _deductionTypes = new();

    private string _accountName = string.Empty;
    private string _bankName = string.Empty;
    private string _branchName = string.Empty;
    private string _accountNumber = string.Empty;
    private string _accountCurrency = string.Empty;
    private PaymentPurpose _accountPurpose = PaymentPurpose.NetPay;

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        _company = Db.Companies.FirstOrDefault();

        // The company's own default, not a currency this screen decided on.
        if (string.IsNullOrEmpty(_accountCurrency))
        {
            _accountCurrency = _company?.DefaultPayrollCurrency ?? string.Empty;
        }
        if (_company is null)
        {
            return;
        }

        _currencies = Db.CompanyCurrencies.Where(c => c.CompanyId == _company.Id)
            .OrderBy(c => c.SortOrder).ToList();
        _referenceCurrencies = Db.Currencies.AsNoTracking().OrderBy(c => c.SortOrder).ToList();
        _rates = Db.ExchangeRates.AsNoTracking().OrderByDescending(r => r.RateDate).Take(20).ToList();
        _bankAccounts = Db.CompanyBankAccounts.AsNoTracking()
            .Where(a => a.CompanyId == _company.Id).OrderBy(a => a.CurrencyCode).ToList();
        _earningTypes = Db.EarningTypes.AsNoTracking()
            .Where(t => t.CompanyId == _company.Id).OrderBy(t => t.DisplayOrder).ToList();
        _deductionTypes = Db.DeductionTypes.AsNoTracking()
            .Where(t => t.CompanyId == _company.Id).OrderBy(t => t.DisplayOrder).ToList();
        _glMappings = await Journals.GetMappingsAsync(_company.Id);
        _databasePath = Backups.DatabasePath();
    }

    /// <summary>The pending edit for a cell, falling back to what is stored.</summary>
    private string Edit(string key, string field, string? stored) =>
        _glEdits.GetValueOrDefault($"{key}:{field}", stored ?? string.Empty);

    private void SetEdit(string key, string field, object? value) =>
        _glEdits[$"{key}:{field}"] = value?.ToString() ?? string.Empty;

    private static string Describe(GlMappingType type) => type switch
    {
        GlMappingType.WagesExpense => "Gross wages (expense)",
        GlMappingType.NetPayLiability => "Net pay owed to employees",
        GlMappingType.PayeLiability => "PAYE withheld",
        GlMappingType.AidsLevyLiability => "AIDS Levy withheld",
        GlMappingType.NssaEmployeeLiability => "NSSA employee contribution withheld",
        GlMappingType.NssaEmployerExpense => "NSSA employer contribution (expense)",
        GlMappingType.NssaEmployerLiability => "NSSA employer contribution payable",
        GlMappingType.EmployerStatutoryExpense => "Employer statutory costs (expense)",
        GlMappingType.EmployerStatutoryLiability => "Employer statutory costs payable",
        GlMappingType.OtherDeductionLiability => "Other deductions withheld",
        _ => "Loan and advance recoveries"
    };

    private async Task SaveMappingAsync(GlMappingType type, string currency, string key)
    {
        var existing = _glMappings.FirstOrDefault(m =>
            m.MappingType == type && m.CurrencyCode == currency);

        var result = await Journals.SetMappingAsync(
            _company!.Id, type, currency,
            Edit(key, "code", existing?.AccountCode),
            Edit(key, "name", existing?.AccountName),
            Edit(key, "cc", existing?.CostCentre));

        _validation = result.IsValid ? null : result;
        _saved = result.IsValid;
        Db.ChangeTracker.Clear();
        await Load();
    }

    private async Task BackupAsync()
    {
        var result = await Backups.BackupAsync(_backupFolder, _backupNote);
        _validation = result.Succeeded ? null : result.Validation;
        _lastBackup = result.Succeeded ? result.Value : null;
    }

    private async Task InspectAsync()
    {
        _restoreMessage = null;
        _inspection = await Backups.InspectAsync(_restoreFolder);
    }

    private async Task RestoreAsync()
    {
        var result = await Backups.RestoreAsync(_restoreFolder, _restoreConfirmed);
        _validation = result.Succeeded ? null : result.Validation;
        _restoreMessage = result.Succeeded
            ? $"The previous database was kept as {result.Value}."
            : null;
    }

    private void SetDefaultPayroll(CompanyCurrency currency)
    {
        foreach (var item in _currencies)
        {
            item.IsDefaultPayrollCurrency = item.Id == currency.Id;
        }
    }

    private void SetDefaultReporting(CompanyCurrency currency)
    {
        foreach (var item in _currencies)
        {
            item.IsDefaultReportingCurrency = item.Id == currency.Id;
        }
    }

    private async Task SaveCompanyAsync()
    {
        Session.Require(Permissions.CompanyEdit);

        var validation = ValidationResult.Success();
        validation.Require(_company!.LegalName, "Legal name");
        validation.AddIf(
            !string.IsNullOrWhiteSpace(_company.Email) && !_company.Email.Contains('@'),
            "Email", "Email address is not valid.");

        _validation = validation;
        _saved = false;
        if (!validation.IsValid)
        {
            return;
        }

        await Db.SaveChangesAsync();
        _validation = null;
        _saved = true;
        await Load();
    }

    private async Task SaveCurrenciesAsync()
    {
        Session.Require(Permissions.CompanyEdit);

        var validation = ValidationResult.Success();
        validation.AddIf(_currencies.Count(c => c.IsEnabled) == 0, "Currencies",
            "At least one currency must be enabled.");
        validation.AddIf(_currencies.Count(c => c.IsDefaultPayrollCurrency) != 1, "Currencies",
            "Exactly one default payroll currency is required.");
        validation.AddIf(
            _currencies.Any(c => c.IsDefaultPayrollCurrency && !c.IsEnabled), "Currencies",
            "The default payroll currency must be enabled.");

        _validation = validation;
        _saved = false;
        if (!validation.IsValid)
        {
            return;
        }

        _company!.DefaultPayrollCurrency =
            _currencies.First(c => c.IsDefaultPayrollCurrency).CurrencyCode;
        _company.DefaultReportingCurrency =
            _currencies.FirstOrDefault(c => c.IsDefaultReportingCurrency)?.CurrencyCode
            ?? _company.DefaultPayrollCurrency;

        await Db.SaveChangesAsync();
        _validation = null;
        _saved = true;
        await Load();
    }

    private async Task AddBankAccountAsync()
    {
        Session.Require(Permissions.CompanyEdit);

        var validation = ValidationResult.Success();
        validation.Require(_accountName, "Account name");
        validation.Require(_bankName, "Bank");
        validation.Require(_accountNumber, "Account number");
        validation.AddIf(
            Db.CompanyBankAccounts.Any(a => a.CompanyId == _company!.Id &&
                                            a.AccountNumber == _accountNumber &&
                                            a.CurrencyCode == _accountCurrency),
            "Account number", "That account is already captured for this currency.");

        _validation = validation;
        _saved = false;
        if (!validation.IsValid)
        {
            return;
        }

        Db.CompanyBankAccounts.Add(new CompanyBankAccount
        {
            CompanyId = _company!.Id,
            AccountName = _accountName,
            BankName = _bankName,
            BranchName = _branchName,
            AccountNumber = _accountNumber,
            CurrencyCode = _accountCurrency,
            Purpose = _accountPurpose,
            IsActive = true
        });
        await Db.SaveChangesAsync();

        _accountName = _bankName = _branchName = _accountNumber = string.Empty;
        _validation = null;
        _saved = true;
        await Load();
    }
}
