@namespace Tawaka.Ui.Shared.Components.Pages
@page "/"
@using Tawaka.Application.Administration
@using Tawaka.Application.Release
@inject DashboardService DashboardSource
@inject PayrollDbContext Db
@inject UserSession Session

@* Every figure here is computed from the database. There is no sample or placeholder number
   anywhere: a dashboard showing a plausible figure nobody computed is worse than an empty one,
   because it gets believed. *@

<div class="page-header">
    <div>
        <h1>Dashboard</h1>
        <div class="subtitle">@(_data?.CompanyName ?? "Tawaka Payroll")</div>
    </div>
</div>

@if (_data is null)
{
    <div class="card"><EmptyState Title="Loading…" /></div>
}
else
{
    <div class="card release-card @Css(_data.Readiness.Stage)">
        <div class="page-header">
            <div>
                <h2>@_data.Readiness.StageLabel</h2>
                <div class="subtitle">@_data.Readiness.StageExplanation</div>
            </div>
            <a class="btn btn-quiet" href="statutory/compliance">Compliance status</a>
        </div>
    </div>

    <div class="stat-row">
        <div class="stat">
            <div class="stat-value">@_data.EmployeesActive</div>
            <div class="stat-label">Active employees</div>
        </div>
        <div class="stat">
            <div class="stat-value">@_data.PendingApprovals</div>
            <div class="stat-label">Inputs awaiting approval</div>
        </div>
        <div class="stat">
            <div class="stat-value">@_data.RunsAwaitingApproval</div>
            <div class="stat-label">Payrolls awaiting approval</div>
        </div>
        <div class="stat">
            <div class="stat-value">@_data.OutstandingObligations.Sum(o => o.Count)</div>
            <div class="stat-label">Obligations outstanding</div>
        </div>
        <div class="stat">
            <div class="stat-value">@_data.RunsLocked</div>
            <div class="stat-label">Payrolls locked</div>
        </div>
        <div class="stat">
            <div class="stat-value">@_data.ProjectsActive</div>
            <div class="stat-label">Active projects</div>
        </div>
    </div>

    <div class="card">
        <h2>Current payroll period</h2>
        @if (_data.CurrentPeriod is null)
        {
            <EmptyState Title="No payroll period"
                        Description="Create the period you want to process in Payroll." />
        }
        else
        {
            <div class="detail-grid">
                <div><span class="detail-label">Period</span>@_data.CurrentPeriod.Name</div>
                <div>
                    <span class="detail-label">Dates</span>
                    @_data.CurrentPeriod.StartDate.ToString("dd MMM") –
                    @_data.CurrentPeriod.EndDate.ToString("dd MMM yyyy")
                </div>
                <div>
                    <span class="detail-label">Pay date</span>
                    @_data.CurrentPeriod.PayDate.ToString("dd MMM yyyy")
                </div>
                <div>
                    <span class="detail-label">Period status</span>
                    <StatusBadge Label="@_data.CurrentPeriod.Status.ToString()"
                                 Tone="@(_data.CurrentPeriod.IsLocked ? "disabled" : "verified")" />
                </div>
                <div>
                    <span class="detail-label">Latest run</span>
                    @if (_data.LatestRun is { } run)
                    {
                        <span>
                            Run @run.RunNumber
                            <StatusBadge Label="@run.Status.ToString()" Tone="@RunTone(run.Status)" />
                        </span>
                    }
                    else
                    {
                        <span class="muted">none</span>
                    }
                </div>
                <div>
                    <span class="detail-label">Unapproved timesheets</span>
                    @if (_data.UnapprovedInputsInCurrentPeriod > 0)
                    {
                        <span class="strong">@_data.UnapprovedInputsInCurrentPeriod</span>
                    }
                    else
                    {
                        <span class="muted">none</span>
                    }
                </div>
            </div>
            <div class="form-actions">
                <a class="btn btn-secondary" href="payroll">Open payroll</a>
                <a class="btn btn-quiet" href="time-leave/approvals">Approval queue</a>
            </div>
        }
    </div>

    <div class="card">
        <h2>Attention required</h2>
        @if (_data.Warnings.Count == 0)
        {
            <EmptyState Title="Nothing needs attention" />
        }
        else
        {
            <ul class="warning-list">
                @foreach (var warning in _data.Warnings)
                {
                    <li class="warning @warning.Tone">
                        <span class="warning-icon">!</span>
                        <span>@warning.Message</span>
                        @if (warning.Link is not null)
                        {
                            <a href="@warning.Link">@(warning.Action ?? "Open")</a>
                        }
                    </li>
                }
            </ul>
        }
    </div>

    <div class="card">
        <h2>Statutory obligations outstanding</h2>
        @if (_data.OutstandingObligations.Count == 0)
        {
            <EmptyState Title="Nothing outstanding"
                        Description="Obligations appear once a payroll run is finalised." />
        }
        else
        {
            <table class="data">
                <thead>
                <tr><th>Currency</th><th class="num">Obligations</th><th class="num">Outstanding</th>
                    <th class="num">Overdue</th></tr>
                </thead>
                <tbody>
                @foreach (var row in _data.OutstandingObligations)
                {
                    <tr>
                        <td class="strong">@row.CurrencyLabel</td>
                        <td class="num">@row.Count</td>
                        <td class="num strong">@row.Outstanding.ToString("N2")</td>
                        <td class="num @(row.Overdue > 0 ? "strong" : null)">
                            @(row.Overdue > 0 ? row.Overdue.ToString() : "—")
                        </td>
                    </tr>
                }
                </tbody>
            </table>
            <p class="muted small">
                Per currency. A USD liability is settled in USD and a ZiG liability in ZiG; the two
                are never combined.
            </p>
        }
    </div>

    <div class="card">
        <h2>Contracted basic pay by currency</h2>
        @if (_data.ContractedBasicByCurrency.Count == 0)
        {
            <EmptyState Title="No current contracts yet"
                        Description="Add employees and their contracts to see committed payroll cost." />
        }
        else
        {
            <table class="data">
                <thead>
                <tr><th>Currency</th><th class="num">Employees</th><th class="num">Contracted basic</th></tr>
                </thead>
                <tbody>
                @foreach (var row in _data.ContractedBasicByCurrency)
                {
                    <tr>
                        <td class="strong">@row.CurrencyLabel</td>
                        <td class="num">@row.Employees</td>
                        <td class="num">@row.Amount.ToString("N2")</td>
                    </tr>
                }
                </tbody>
            </table>
            <p class="muted small">
                Contracted rates, not a payroll result. What was actually paid is in Reports.
            </p>
        }
    </div>

    <div class="card">
        <h2>Recent payroll activity</h2>
        @if (_data.RecentActivity.Count == 0)
        {
            <EmptyState Title="No payroll runs yet" />
        }
        else
        {
            <table class="data">
                <thead>
                <tr><th>When</th><th>Period</th><th class="num">Run</th><th>Status</th><th>By</th></tr>
                </thead>
                <tbody>
                @foreach (var row in _data.RecentActivity)
                {
                    <tr>
                        <td>@row.At.ToString("dd MMM yyyy HH:mm")</td>
                        <td class="strong">@row.PeriodName</td>
                        <td class="num">@row.RunNumber</td>
                        <td>@row.Status</td>
                        <td class="muted">@(row.Actor ?? "—")</td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </div>
}

@code {
    private DashboardData? _data;

    protected override async Task OnInitializedAsync()
    {
        // The signed-in user's company, falling back to the one this installation holds.
        var companyId = Session.CompanyId
                        ?? Db.Companies.AsNoTracking().Select(c => c.Id).FirstOrDefault();

        _data = await DashboardSource.BuildAsync(companyId);
    }

    private static string Css(ReleaseStage stage) => stage switch
    {
        ReleaseStage.LivePayrollEnabled => "live",
        ReleaseStage.ReadyForControlledTesting => "testing",
        ReleaseStage.ComplianceUnverified => "unverified",
        _ => "development"
    };

    private static string RunTone(PayrollRunStatus status) => status switch
    {
        PayrollRunStatus.Approved or PayrollRunStatus.Finalised or PayrollRunStatus.Paid => "verified",
        PayrollRunStatus.Review or PayrollRunStatus.Calculating => "supported",
        PayrollRunStatus.Locked => "disabled",
        _ => "disabled"
    };
}
