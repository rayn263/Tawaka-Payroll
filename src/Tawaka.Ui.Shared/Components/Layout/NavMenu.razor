@namespace Tawaka.Ui.Shared.Components.Layout
@inject UserSession Session
@inject PayrollDbContext Db

@* Ten modules, matching how a payroll office is actually organised. Related screens live together
   as tabs inside a module rather than as separate navigation entries: a person looking for leave
   balances should not have to know whether we filed them under Leave or under Employees.

   Permission-trimmed throughout: a user never sees a module they cannot open. *@

<nav>
    <NavLink href="" Match="NavLinkMatch.All">Dashboard</NavLink>

    @if (Session.HasPermission(Permissions.EmployeesView))
    {
        <NavLink href="employees">Employees</NavLink>
    }

    @if (Session.HasPermission(Permissions.PayrollView))
    {
        <NavLink href="payroll">Payroll</NavLink>
    }

    @if (Session.HasPermission(Permissions.TimeView) || Session.HasPermission(Permissions.LeaveView))
    {
        <NavLink href="time-leave">
            Time &amp; Leave
            @if (_pendingApprovals > 0)
            {
                <span class="nav-count" title="Inputs awaiting approval">@_pendingApprovals</span>
            }
        </NavLink>
    }

    @if (Session.HasPermission(Permissions.LoansView))
    {
        <NavLink href="loans">Loans &amp; Advances</NavLink>
    }

    @if (Session.HasPermission(Permissions.ProjectsView))
    {
        <NavLink href="projects">Projects &amp; Sites</NavLink>
    }

    @if (Session.HasPermission(Permissions.StatutoryView))
    {
        <NavLink href="statutory">Statutory</NavLink>
    }

    @if (Session.HasPermission(Permissions.ReportsRun))
    {
        <NavLink href="reports">Reports</NavLink>
    }

    @if (Session.HasPermission(Permissions.CompanyView))
    {
        <NavLink href="settings">Settings</NavLink>
    }

    @if (Session.HasPermission(Permissions.AuditView) || Session.HasPermission(Permissions.UsersManage))
    {
        <NavLink href="administration">Administration</NavLink>
    }
</nav>

@code {
    private int _pendingApprovals;

    protected override void OnInitialized()
    {
        // A count on the menu, because an unapproved timesheet that nobody notices becomes an
        // employee who was not paid for work they did.
        if (!Session.HasPermission(Permissions.TimeView) &&
            !Session.HasPermission(Permissions.LeaveView))
        {
            return;
        }

        _pendingApprovals =
            Db.Timesheets.AsNoTracking()
                .Count(t => t.ApprovalStatus == InputApprovalStatus.Submitted) +
            Db.LeaveRequests.AsNoTracking()
                .Count(r => r.ApprovalStatus == InputApprovalStatus.Submitted) +
            Db.EmployeeLoans.AsNoTracking()
                .Count(l => l.ApprovalStatus == InputApprovalStatus.Submitted);
    }
}
