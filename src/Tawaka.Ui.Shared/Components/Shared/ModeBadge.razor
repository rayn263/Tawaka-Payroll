@namespace Tawaka.Ui.Shared.Components.Shared
@using Tawaka.Application.Release
@inject ReleaseReadinessService Readiness

@* The release stage is shown at all times, in every screen's top bar. A payroll system that lets
   somebody forget its tax tables have never been checked is the one that gets used anyway. *@

@if (_readiness is not null)
{
    <span class="mode-badge @CssClass" title="@_readiness.StageExplanation">
        @_readiness.StageLabel
        @if (_readiness.RulesUnverified > 0)
        {
            <span class="mode-detail">
                @_readiness.RulesUnverified of @_readiness.RulesTotal rules unverified
            </span>
        }
    </span>
}

@code {
    private ReleaseReadiness? _readiness;

    private string CssClass => _readiness?.Stage switch
    {
        ReleaseStage.LivePayrollEnabled => "live",
        ReleaseStage.ReadyForControlledTesting => "testing",
        ReleaseStage.ComplianceUnverified => "unverified",
        _ => "development"
    };

    protected override async Task OnInitializedAsync() =>
        _readiness = await Readiness.EvaluateAsync();
}
