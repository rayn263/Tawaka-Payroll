<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    The desktop shell: a WPF host with a BlazorWebView, so screens are Razor components that can
    later be served unchanged by ASP.NET Core (ADR-001).

    Screens themselves live in Tawaka.Ui.Shared, a Razor class library targeting net8.0, so the
    whole user interface compiles and is verified on any platform. This project is only the host:
    a window, a WebView and the startup wiring. It targets net8.0-windows and therefore builds
    only on Windows, which is why the cross-platform solution (Tawaka.Payroll.Core.sln) excludes
    it (ADR-019).
  -->

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Tawaka.Ui.Desktop</RootNamespace>
    <AssemblyName>Tawaka.Payroll</AssemblyName>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Wpf" Version="8.0.100" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tawaka.Domain\Tawaka.Domain.csproj" />
    <ProjectReference Include="..\Tawaka.Application\Tawaka.Application.csproj" />
    <ProjectReference Include="..\Tawaka.Payroll.Engine\Tawaka.Payroll.Engine.csproj" />
    <ProjectReference Include="..\Tawaka.Infrastructure\Tawaka.Infrastructure.csproj" />
    <ProjectReference Include="..\Tawaka.Ui.Shared\Tawaka.Ui.Shared.csproj" />
  </ItemGroup>

</Project>
