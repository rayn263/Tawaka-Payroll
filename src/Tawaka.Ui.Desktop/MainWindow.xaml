<Window x:Class="Tawaka.Ui.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:blazor="clr-namespace:Microsoft.AspNetCore.Components.WebView.Wpf;assembly=Microsoft.AspNetCore.Components.WebView.Wpf"
        xmlns:shared="clr-namespace:Tawaka.Ui.Shared.Components;assembly=Tawaka.Ui.Shared"
        xmlns:local="clr-namespace:Tawaka.Ui.Desktop"
        Title="Tawaka Payroll" Height="900" Width="1500" WindowStartupLocation="CenterScreen">
    <Grid>
        <blazor:BlazorWebView x:Name="BlazorWebView" HostPage="wwwroot\index.html" Services="{x:Static local:App.Services}">
            <blazor:BlazorWebView.RootComponents>
                <blazor:RootComponent Selector="#app" ComponentType="{x:Type shared:App}" />
            </blazor:BlazorWebView.RootComponents>
        </blazor:BlazorWebView>
    </Grid>
</Window>
