<?xml version="1.0" encoding="utf-8"?>
<!--
  The release build of the Windows application.

    dotnet publish src/Tawaka.Ui.Desktop -c Release -p:PublishProfile=win-x64

  Self-contained, so the target machine needs no .NET runtime — only Microsoft's WebView2
  Evergreen runtime, which is already present on Windows 11 and on up-to-date Windows 10.

  These settings live here rather than in the project file so that an ordinary `dotnet build`
  is unaffected: a project that is always self-contained and always win-x64 cannot be built or
  tested on anything else.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishProtocol>FileSystem</PublishProtocol>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

    <!--
      Trimming is deliberately off. Entity Framework Core builds its model by reflection, and a
      trimmer that removes an entity type the model needs fails at startup on the user's machine
      rather than in a build. The extra size is not worth that risk in a payroll application.
    -->
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>true</PublishReadyToRun>

    <PublishDir>bin\Release\publish\win-x64\</PublishDir>
  </PropertyGroup>
</Project>
