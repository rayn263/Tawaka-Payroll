@namespace Tawaka.Ui.Desktop.Components.Pages
@page "/"
@using Microsoft.EntityFrameworkCore
@using Tawaka.Application.Statutory
@using Tawaka.Domain.Payroll
@using Tawaka.Infrastructure.Persistence
@inject PayrollDbContext Db
@inject LivePayrollGate Gate

<h2>Statutory rule register</h2>
<p class="muted">
    Every statutory value used by this system is a dated, sourced rule. Live payroll resolves only
    rules marked Verified.
</p>

@if (_blockReport is { IsBlocked: true })
{
    <div class="blocked">
        <h2>@LivePayrollBlockReport.Headline</h2>
        <p>@LivePayrollBlockReport.Summary</p>
        <ul>
            @foreach (var rule in _blockReport.BlockingRules)
            {
                <li>
                    <strong>@(rule.RuleId ?? rule.Description)</strong>
                    @if (!string.IsNullOrWhiteSpace(rule.RuleName))
                    {
                        <text> — @rule.RuleName</text>
                    }
                    <div class="muted">@rule.Reason</div>
                    @if (!string.IsNullOrWhiteSpace(rule.Remedy))
                    {
                        <div class="muted">To clear: @rule.Remedy</div>
                    }
                </li>
            }
        </ul>
    </div>
}

<div class="card">
    <table>
        <thead>
        <tr>
            <th>Rule ID</th>
            <th>Name</th>
            <th>Currency</th>
            <th>Effective from</th>
            <th>Effective to</th>
            <th>Status</th>
            <th>Source</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var rule in _rules)
        {
            <tr>
                <td>@rule.RuleId</td>
                <td>@rule.Name</td>
                <td>@(rule.Currency ?? "—")</td>
                <td>@rule.EffectiveFrom.ToString("dd MMM yyyy")</td>
                <td>@(rule.EffectiveTo?.ToString("dd MMM yyyy") ?? "open")</td>
                <td><span class="badge @rule.VerificationStatus.ToString().ToLowerInvariant()">@rule.VerificationStatus</span></td>
                <td class="muted">@rule.Source?.Source</td>
            </tr>
        }
        </tbody>
    </table>
</div>

@code {
    private List<StatutoryRule> _rules = new();
    private LivePayrollBlockReport? _blockReport;

    protected override void OnInitialized()
    {
        _rules = Db.StatutoryRules.AsNoTracking()
            .OrderBy(r => r.RuleId)
            .ToList();

        var payDate = DateOnly.FromDateTime(DateTime.Today);
        _blockReport = Gate.Check(new[]
        {
            new StatutoryRuleQuery
            {
                RuleType = StatutoryRuleType.PayeTable,
                EffectiveDate = payDate,
                Currency = CurrencyCode.Usd,
                PeriodBasis = PeriodBasis.Monthly
            },
            new StatutoryRuleQuery
            {
                RuleType = StatutoryRuleType.NssaPobs,
                EffectiveDate = payDate,
                Currency = CurrencyCode.Usd
            },
            new StatutoryRuleQuery
            {
                RuleType = StatutoryRuleType.AidsLevy,
                EffectiveDate = payDate
            },
            new StatutoryRuleQuery
            {
                RuleType = StatutoryRuleType.Apwcs,
                EffectiveDate = payDate,
                Currency = CurrencyCode.Usd
            }
        });
    }
}
